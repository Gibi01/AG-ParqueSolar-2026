# Copernicus Climate Data Store (CDS) API credentials.
#
# How to obtain it:
#   1. Create a free account at https://cds.climate.copernicus.eu
#   2. Log in and open https://cds.climate.copernicus.eu/how-to-api
#   3. Copy your personal access token (shown on that page once logged in).
#   4. Set it below. Never commit the real value — this file only documents
#      the variable name, it must stay empty here.
#
# The application reads this variable directly (via python-dotenv) AND/OR
# writes/reads it through the standard cdsapi config file (~/.cdsapirc) —
# see src/api/copernicus_era5_land.py for details. Do not hardcode the key
# in any source file.
CDS_API_KEY=

# Optional: override the CDS API URL (defaults to the official endpoint).
# Only change this if Copernicus documents a different endpoint.
CDS_API_URL=https://cds.climate.copernicus.eu/api

# Optional: override paths / behavior for local development.
# APP_ENV=development
